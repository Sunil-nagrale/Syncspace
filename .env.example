# ==============================================================================
# SyncSpace — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development. Never commit real secrets.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
# Example: postgresql://postgres:postgres@localhost:5432/syncspace?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/syncspace?schema=public

# Better Auth Configuration
# Required: In production, BETTER_AUTH_SECRET must be set to a cryptographically strong secret (minimum 32 characters).
# Production runtime strictly rejects missing, placeholder, or predictable development keys.
# Generate a secure secret using: openssl rand -base64 32
BETTER_AUTH_SECRET=placeholder_auth_secret_minimum_32_characters_for_jwt_and_cookies
BETTER_AUTH_URL=http://localhost:3000
# Optional in dev; in production specify comma-separated allowed origins (e.g. https://syncspace.dev,https://*.vercel.app)
BETTER_AUTH_TRUSTED_ORIGINS=https://syncspace.dev,http://localhost:3000

# OAuth Providers (Optional for local dev, required for social login)
GITHUB_CLIENT_ID=placeholder_github_client_id
GITHUB_CLIENT_SECRET=placeholder_github_client_secret
GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret

# Liveblocks Real-Time Collaboration (Server-only secret key used by /api/liveblocks-auth)
# Retrieve from https://liveblocks.io/dashboard/apikeys — never expose to the browser
LIVEBLOCKS_SECRET_KEY=sk_dev_placeholder_liveblocks_secret_key

# Private Object Storage Configuration
# Supported providers: "s3" (required in production), "local" (local dev outside public root), "memory" (automated tests)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.storage/attachments

# S3-Compatible Private Object Storage (AWS S3, MinIO, or Cloudflare R2)
# Required when STORAGE_PROVIDER=s3 or NODE_ENV=production. Keep bucket private (Block Public Access enabled).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=placeholder_s3_access_key
S3_SECRET_ACCESS_KEY=placeholder_s3_secret_key
S3_BUCKET_NAME=syncspace-attachments
S3_FORCE_PATH_STYLE=true
